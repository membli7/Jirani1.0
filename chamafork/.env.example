PORT=8001
# Production HTTPS redirects use this trusted origin instead of the request Host header.
APP_CANONICAL_ORIGIN=
# Exact public HTTPS origins accepted on browser write requests, comma-separated.
APP_ALLOWED_ORIGINS=
# Set to 1 only when running behind a trusted proxy. Production validates this setting.
TRUST_PROXY=0
# Exact private IPs of trusted reverse proxies, comma-separated (no CIDR ranges).
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional listener bind IP. Defaults to 127.0.0.1; production allows only loopback or private IPs.
APP_BIND_HOST=
# Optional development switches. Leave disabled for normal local use.
FORCE_HTTPS_REDIRECT=0
FORCE_SECURE_COOKIE=0
FORCE_METRICS_AUTH=0
#Session configuration
# Generate independent values with: openssl rand -base64 48. Keep generated values in .env only.
SESSION_SECRET=
METRICS_BEARER_TOKEN=
# Local development uses in-process sessions; production requires Redis.
SESSION_STORE=memory
SESSION_REDIS_PREFIX=
# Required in production. Redis keeps sessions available across restarts and instances.
REDIS_URL=
# Optional. Set to redis to use Redis for rate-limit state outside production.
RATE_LIMIT_STORE=
# Required for the PostgreSQL foundation migration and database access.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# PostgreSQL pool/TLS settings. Production requires certificate verification.
PG_POOL_MAX=
PGSSL=verify-full
PGSSL_CA_FILE=
# Sandbox-only inbound M-PESA C2B subscription verification; the app never sends STK/payment requests.
MPESA_ENV=sandbox
# Keep disabled until both public HTTPS callback URLs are registered in the sandbox account.
MPESA_C2B_CALLBACKS_ENABLED=0
MPESA_C2B_VALIDATION_URL=https://your-public-host.example/api/mpesa/c2b/validation
MPESA_C2B_CONFIRMATION_URL=https://your-public-host.example/api/mpesa/c2b/confirmation
# Comma-separated chama-source-id=business-shortcode pairs, for example: chama-id=600000.
MPESA_SHORTCODE_CHAMA_MAP=
# Optional JSON data file path when DATA_BACKEND=json; blank uses data.json in this folder.
CHAMA_DATA_FILE=
# Optional login throttling overrides (defaults: 15 minutes and 10000 failures).
CHAMA_LOGIN_LOCKOUT_MS=900000
CHAMA_LOGIN_FAILURE_CAP=10000
# On an empty data store, create the first chairperson from the app setup screen.
# Required to send member invitations.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

DATA_BACKEND=json
# Optional. Leave blank unless configuring Africa's Talking delivery.



# Email delivery (Nodemailer). Required for invitation codes and OTP sign-in.
SMTP_TRANSPORT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_LOG_FILE=
