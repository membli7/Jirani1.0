PORT=8001
# Production HTTPS redirects use this trusted origin instead of the request Host header.
APP_CANONICAL_ORIGIN=
# Exact public HTTPS origins accepted on browser write requests, comma-separated.
APP_ALLOWED_ORIGINS=
# Set to 1 only when running behind a trusted proxy. Production validates this setting.
TRUST_PROXY=0
# Exact private IPs of trusted reverse proxies, comma-separated (no CIDR ranges).
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional listener bind IP. Defaults to 127.0.0.1; production allows only loopback or private IPs.
APP_BIND_HOST=
#Session configuration
# Generate independent values with: openssl rand -base64 48. Keep generated values in .env only.
SESSION_SECRET=
METRICS_BEARER_TOKEN=
# Local development uses in-process sessions; production requires Redis.
SESSION_STORE=memory
SESSION_REDIS_PREFIX=
# Required in production. Redis keeps sessions available across restarts and instances.
REDIS_URL=
# Required for the PostgreSQL foundation migration and database access.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# PostgreSQL pool/TLS settings. Production requires certificate verification.
PG_POOL_MAX=
PGSSL=verify-full
PGSSL_CA_FILE=
# On an empty data store, create the first chairperson from the app setup screen.
# Required to send member invitations.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

DATA_BACKEND=json
# M-Pesa settlement callbacks are disabled until request authentication and exact amount matching are implemented.
# These reserved settings do not enable M-Pesa payment processing.
MPESA_ENV=
MPESA_BASE_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# JSON object mapping each configured BusinessShortCode to the chama's source ID.
MPESA_SHORTCODE_CHAMA_MAP={}
# Public callback URL used for STK Push requests when enabled.
MPESA_STK_CALLBACK_URL=
# Optional override; defaults to 120000 ms with a 90000 ms minimum age.
MPESA_STK_RECONCILE_INTERVAL_MS=120000
MPESA_STK_PENDING_AFTER_MS=90000
# Imported daily Daraja/paybill statement and generated JSON report location.
MPESA_PAYBILL_STATEMENT_CSV=
MPESA_RECONCILIATION_REPORT_DIR=
# Optional. Leave blank unless configuring Africa's Talking delivery.



# Email delivery (Nodemailer). Required for invitation codes and OTP sign-in.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
